# Copy to .env.production, replace every CHANGE_ME value, chmod 600, and never commit it.
# Compose: docker compose --env-file ../.env.production -f compose.production.yml ...

PHOKARTA_IMAGE=registry.example.com/phokarta/backend:sha-CHANGE_ME
PHOKARTA_RELEASE=sha-CHANGE_ME
PHOKARTA_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
APP_ENVIRONMENT=production

# Self-hosted Compose database:
PHOKARTA_DB_URL=jdbc:postgresql://db:5432/phokarta
PHOKARTA_DB_USER=phokarta_app
PHOKARTA_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=phokarta

# Managed database alternative (replace the URL above; require TLS per provider guidance):
# PHOKARTA_DB_URL=jdbc:postgresql://db.example.com:5432/phokarta?sslmode=require

# Generate at least 32 random bytes; do not reuse another application's secret.
PHOKARTA_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PHOKARTA_CORS_ALLOWED_ORIGINS=https://app.example.com
PHOKARTA_JWT_ACCESS_TTL=15m
PHOKARTA_JWT_REFRESH_TTL=30d

SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=prod
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=UTC

LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
