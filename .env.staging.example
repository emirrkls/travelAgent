# Copy to .env.staging (outside Git), replace every CHANGE_ME value, chmod 600, and never commit it.
# Compose: docker compose --env-file ../.env.staging -f compose.production.yml --profile self-hosted-db ...
# Helper: scripts/deploy-staging.sh [--profile self-hosted-db] /opt/phokarta/staging/.env.staging
#
# Staging uses the production Spring profile with APP_ENVIRONMENT=staging.
# Placeholders only. Do not reuse local backend/.env or a future production secret.

PHOKARTA_IMAGE=phokarta-backend:e6502d7df9cc45193c92496db8ca70d243340f32
PHOKARTA_RELEASE=e6502d7df9cc45193c92496db8ca70d243340f32
PHOKARTA_DOMAIN=api-staging.example.com
ACME_EMAIL=ops@example.com
APP_ENVIRONMENT=staging
SPRING_PROFILES_ACTIVE=prod

# Self-hosted Compose database (profile self-hosted-db). Port 5432 stays unpublished.
PHOKARTA_DB_URL=jdbc:postgresql://db:5432/phokarta
PHOKARTA_DB_USER=phokarta_app
PHOKARTA_DB_PASSWORD=CHANGE_ME_STAGING_ONLY_DATABASE_PASSWORD
POSTGRES_DB=phokarta

# Managed PostgreSQL/PostGIS alternative (omit --profile self-hosted-db):
# PHOKARTA_DB_URL=jdbc:postgresql://db.example.com:5432/phokarta?sslmode=require

# Staging-only JWT secret. Generate at least 32 random bytes. Do not reuse the database password.
PHOKARTA_JWT_SECRET=CHANGE_ME_STAGING_ONLY_JWT_SECRET_MIN_32_CHARS
PHOKARTA_CORS_ALLOWED_ORIGINS=https://admin-staging.example.com
PHOKARTA_JWT_ACCESS_TTL=15m
PHOKARTA_JWT_REFRESH_TTL=30d

# Private HTTPS S3-compatible bucket. Not localhost MinIO.
# Leave endpoint blank for AWS S3. Compatible providers need an absolute HTTPS endpoint.
# path-style is provider-dependent (false for typical AWS virtual-host style).
PHOKARTA_MEDIA_ENABLED=true
PHOKARTA_MEDIA_BUCKET=CHANGE_ME_STAGING_PRIVATE_MEDIA_BUCKET
PHOKARTA_MEDIA_REGION=CHANGE_ME_STORAGE_REGION
PHOKARTA_MEDIA_ENDPOINT=
PHOKARTA_MEDIA_PATH_STYLE=false
PHOKARTA_MEDIA_ACCESS_KEY=CHANGE_ME_STAGING_STORAGE_ACCESS_KEY
PHOKARTA_MEDIA_SECRET_KEY=CHANGE_ME_STAGING_STORAGE_SECRET_KEY
PHOKARTA_MEDIA_UPLOAD_TTL=15m
PHOKARTA_MEDIA_READ_TTL=10m
PHOKARTA_MEDIA_MAX_BYTES=15728640
PHOKARTA_MEDIA_MAX_PER_VISIT=20
PHOKARTA_MEDIA_UNATTACHED_TTL=48h
PHOKARTA_MEDIA_CLEANUP_BATCH_SIZE=100
PHOKARTA_MEDIA_CLEANUP_INTERVAL=1h

SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=UTC

LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
