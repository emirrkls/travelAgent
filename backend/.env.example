POSTGRES_DB=phokarta
POSTGRES_USER=phokarta
POSTGRES_PASSWORD=phokarta
POSTGRES_PORT=5432

# Used by Spring Boot when running outside Docker
PHOKARTA_DB_URL=jdbc:postgresql://localhost:5432/phokarta
PHOKARTA_DB_USER=phokarta
PHOKARTA_DB_PASSWORD=phokarta

# JWT signing secret — generate a long random value for any non-local environment.
# Minimum 32 characters. Never commit a real production secret.
PHOKARTA_JWT_SECRET=phokarta-dev-only-jwt-secret-change-me-32b

# Local MinIO only. Production may use IAM/workload credentials instead.
MINIO_ROOT_USER=phokarta-minio
MINIO_ROOT_PASSWORD=phokarta-minio-dev-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PHOKARTA_MEDIA_ENABLED=true
PHOKARTA_MEDIA_BUCKET=phokarta-local-media
PHOKARTA_MEDIA_REGION=us-east-1
PHOKARTA_MEDIA_ENDPOINT=http://localhost:9000
PHOKARTA_MEDIA_PATH_STYLE=true
PHOKARTA_MEDIA_ACCESS_KEY=phokarta-minio
PHOKARTA_MEDIA_SECRET_KEY=phokarta-minio-dev-only

# Optional token lifetime overrides (Spring Duration format)
# PHOKARTA_JWT_ACCESS_TTL=15m
# PHOKARTA_JWT_REFRESH_TTL=30d
