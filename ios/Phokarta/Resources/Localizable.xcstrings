    "delete_account.warning_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile, visits, saved places, collections, social connections, and uploaded photos will be permanently deleted. This action cannot be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiliniz, ziyaretleriniz, kaydedilen yerleriniz, koleksiyonlarınız, sosyal bağlantılarınız ve yüklenen fotoğraflarınız kalıcı olarak silinecektir. Bu işlem geri alınamaz."
          }
        }
      }
    },
