{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phokarta.local/schemas/place-ingestion-config.schema.json",
  "title": "Phokarta Place ingestion benchmark configuration",
  "description": "Contract for the small, versioned provider registry, pilot geography, and category-mapping configuration files.",
  "$defs": {
    "pilotAreas": {
      "type": "object",
      "required": ["geometry_method", "areas"],
      "properties": {
        "geometry_method": {"type": "string", "minLength": 1},
        "areas": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "display_name", "center", "radius_meters", "reasoning"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "display_name": {"type": "string", "minLength": 1},
              "center": {
                "type": "object",
                "additionalProperties": false,
                "required": ["latitude", "longitude"],
                "properties": {
                  "latitude": {"type": "number", "minimum": -90, "maximum": 90},
                  "longitude": {"type": "number", "minimum": -180, "maximum": 180}
                }
              },
              "radius_meters": {"type": "number", "exclusiveMinimum": 0},
              "reasoning": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "providerRegistry": {
      "type": "object",
      "required": ["registry_version", "metadata_retrieved_at", "legal_status", "providers"],
      "properties": {
        "registry_version": {"type": "integer", "minimum": 1},
        "metadata_retrieved_at": {"type": "string", "format": "date-time"},
        "legal_status": {"type": "string", "minLength": 1},
        "providers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "dataset_name",
              "official_documentation",
              "release_discovery",
              "license_documentation",
              "license_identifier",
              "documented_release",
              "documented_schema",
              "attribution_requirement",
              "authentication",
              "delta_support",
              "stable_id_behavior"
            ],
            "properties": {
              "key": {"enum": ["overture", "fsq"]},
              "dataset_name": {"type": "string", "minLength": 1},
              "official_documentation": {"type": "string", "format": "uri"},
              "release_discovery": {"type": "string", "minLength": 1},
              "license_documentation": {"type": "string", "format": "uri"},
              "license_identifier": {"type": "string", "minLength": 1},
              "documented_release": {"type": "string", "minLength": 1},
              "documented_schema": {"type": "string", "minLength": 1},
              "attribution_requirement": {"type": "string", "minLength": 1},
              "authentication": {"type": "string", "minLength": 1},
              "delta_support": {"type": "string", "minLength": 1},
              "stable_id_behavior": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "categoryMappings": {
      "type": "object",
      "required": ["version", "principle", "providers"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "principle": {"type": "string", "minLength": 1},
        "providers": {
          "type": "object",
          "required": ["overture", "fsq"],
          "additionalProperties": false,
          "properties": {
            "overture": {"$ref": "#/$defs/providerMapping"},
            "fsq": {"$ref": "#/$defs/providerMapping"}
          }
        }
      }
    },
    "providerMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "contains"],
      "properties": {
        "exact": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "contains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "category"],
            "properties": {
              "token": {"type": "string", "minLength": 1},
              "category": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
